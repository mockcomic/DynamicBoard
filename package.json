{
	"name": "DynamicBoard",
	"version": "1.0.1",
	"description": "",
	"main": "server.js",
	"bin": "server.js",
	"scripts": {
		"start": "node server.js",
		"start:prod": "node server.js",
		"dev": "nodemon server.js",
		"test": "node --test",
		"docker:save:unix": "./save-docker-image.sh",
		"docker:save:win": "save-docker-image.bat",
		"docker:save": "npm run docker:save:win || npm run docker:save:unix",
		"build:pkg": "pkg . --targets node18-win-x64,node18-macos-x64,node18-linux-x64 --output release/DynamicBoard"
	},
	"pkg": {
		"assets": [
			"public/**/*"
		],
		"scripts": [
			"node_modules/ejs/**/*"
		]
	},
	"license": "ISC",
	"dependencies": {
		"cors": "^2.8.5",
		"ejs": "^3.1.10",
		"express": "^4.18.1",
		"moment": "^2.30.1",
		"node-cmd": "^5.0.0"
	},
	"devDependencies": {
		"nodemon": "^3.1.10"
	}
}
